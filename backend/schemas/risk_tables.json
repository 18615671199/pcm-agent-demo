{
  "tables": {
    "risk_table": {
      "name": "风险辨识表",
      "columns": ["序号", "危险名称", "危险级别", "风险产生原因", "预防措施"],
      "rows_min": 3,
      "rows_max": 10
    },
    "jsa_table": {
      "name": "JSA 作业前安全分析表",
      "columns": ["编号", "工作步骤", "危害因素描述", "可能性L", "暴露频率E", "严重度C", "风险值LEC", "现有控制措施", "进一步改进措施", "剩余风险是否可接受"],
      "rows_min": 3,
      "rows_max": 10,
      "scoring_method": "LEC",
      "LEC_scale": {
        "L_可能性": {"1": "极不可能", "2": "不太可能", "3": "可能", "4": "很可能", "5": "几乎确定"},
        "E_暴露频率": {"1": "罕见", "2": "偶尔", "3": "经常", "4": "频繁", "5": "持续"},
        "C_严重度": {"1": "轻微", "2": "一般", "3": "严重", "4": "重大", "5": "特大"}
      },
      "risk_level_map": {"1-9": "可接受", "10-25": "一般风险", "26-63": "较大风险", "64-125": "重大风险"}
    },
    "emergency_plan": {
      "name": "应急预案",
      "structure": ["预防措施", "应急响应流程", "救援措施", "事后处理"],
      "min_chars": 500
    }
  }
}
